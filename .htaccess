RewriteEngine On
RewriteBase /

# ============================================================
# Sécurité — Fichiers de configuration (clés API) jamais servis en HTTP.
# Filet de sécurité si PHP venait à ne plus s'exécuter (sinon la clé fuiterait
# en clair). Idéalement, ces fichiers vivent HORS de public_html.
# ============================================================
<FilesMatch "^(mollie|cal)-config\.php$">
  Require all denied
</FilesMatch>

# ============================================================
# SEO — Domaine canonique unique : https://south-boat.com
# Consolide toute l'autorité (south-boat.fr, www, http) sur UNE seule URL.
# Évite le contenu dupliqué entre les deux noms de domaine du client.
# ============================================================

# 1) Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://south-boat.com%{REQUEST_URI} [L,R=301]

# 2) south-boat.fr (et www.south-boat.fr) -> south-boat.com
RewriteCond %{HTTP_HOST} (^|\.)south-boat\.fr$ [NC]
RewriteRule ^ https://south-boat.com%{REQUEST_URI} [L,R=301]

# 3) www.south-boat.com -> south-boat.com (sans www)
RewriteCond %{HTTP_HOST} ^www\.south-boat\.com$ [NC]
RewriteRule ^ https://south-boat.com%{REQUEST_URI} [L,R=301]

# ============================================================
# Performance — Images nouvelle génération (WebP)
# Si le navigateur accepte le WebP ET qu'un fichier "nom.jpg.webp"
# existe à côté de l'original, on sert le WebP (2× plus léger) SANS
# changer une seule URL dans le code. Sinon, le JPEG/PNG d'origine.
# ============================================================
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{DOCUMENT_ROOT}/$1.$2.webp -f
RewriteRule ^(.+)\.(jpe?g|png)$ $1.$2.webp [T=image/webp,E=webp:1,L]

# ============================================================
# Fichier statique manquant -> vrai 404 (jamais index.html).
# Sans cette règle, la règle SPA ci-dessous renvoie index.html pour un asset
# absent : le navigateur reçoit du HTML là où il attend une vidéo ou une image,
# et l'échec est totalement silencieux (la vidéo ne démarre simplement jamais).
# Les URLs propres de l'app (/catalogue, /bateau/1...) n'ont pas d'extension :
# elles ne sont pas concernées.
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} \.(mp4|webm|mov|jpe?g|png|webp|svg|gif|ico|css|js|woff2?|ttf)$ [NC]
RewriteRule ^ - [R=404,L]

# ============================================================
# SPA — Sert index.html pour toutes les routes (URLs propres type
# /disponibilites, /catalogue, /bateau/1...) SAUF si le fichier ou le
# dossier demandé existe réellement (images, css, js...).
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# ============================================================
# Performance — cache navigateur pour les assets statiques
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  # JS / CSS versionnés via ?v=… (cache-busting) → cache long 1 an
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  # Vidéos drone (noms de fichiers figés) → cache long 1 an
  ExpiresByType video/mp4 "access plus 1 year"
  # Le HTML ne doit pas être mis en cache trop longtemps (SPA)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# En-tête Vary : indique aux proxys/CDN que l'image dépend du header Accept
# (indispensable quand on sert du WebP OU du JPEG selon le navigateur).
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|webp)$">
    Header append Vary Accept
  </FilesMatch>
  # Polices auto-hébergées : CORS ouvert (au cas où) + cache immuable
  <FilesMatch "\.(woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Vidéos : cache long + lecture en flux (Range) pour le démarrage rapide
  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>

# ============================================================
# Performance — compression
# Brotli si disponible (meilleur que gzip), sinon repli sur gzip/deflate.
# ============================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# Protège le fichier de configuration Cal.com s'il est dans ce dossier
<Files "cal-config.php">
  Require all denied
</Files>
